{
  "name": "jobgitops-installer",
  "version": "0.0.0",
  "description": "Interactive bootstrap installer for JobGitOps repositories",
  "main": "dist/index.js",
  "bin": {
    "jobgitops-installer": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menil/JobGitOps.git",
    "directory": "installer"
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "node -e \"if (require('./package.json').version === '0.0.0') { console.error('Refusing to publish the 0.0.0 placeholder. Stamp a release version first: npm version X.Y.Z --no-git-tag-version'); process.exit(1); }\" && npm run build",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^9.4.1",
    "picocolors": "^1.0.1",
    "tar": "^7.4.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.4.0",
    "@types/tar": "^7.0.87",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@eslint/js": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.0",
    "globals": "^17.11.0",
    "graphql": "^17.0.2",
    "prettier": "^3.3.2",
    "tsup": "^8.1.0",
    "typescript": "^5.5.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
